{
  "id": "mean_words",
  "title": "Ilkeat sanat",
  "learningGoal": "Oppii nimeämään tunteen ja valitsemaan ystävällisen sanan.",
  "durationTarget": "3-4min",
  "steps": [
    { "mode": "baseline", "text": "Hei, olen Lumi.", "pauseMs": 450 },
    { "mode": "baseline", "text": "Puhutaan sanoista, jotka tuntuvat hyvältä.", "pauseMs": 500 },
    { "mode": "listening", "text": "\"Oh\" kuuluu, kun joku sanoo ilkeän sanan. Se sattuu sydämeen.", "pauseMs": 550 },
    { "mode": "listening", "text": "Miltä sinusta tuntuu, kun kuulet ilkeän sanan?", "pauseMs": 950, "teacherHint": "Tunnekuvat" },
    { "mode": "regulation", "text": "Hengitä sisään…", "pauseMs": 650 },
    { "mode": "regulation", "text": "(hiljainen sisäänhengitys)", "pauseMs": 400 },
    { "mode": "regulation", "text": "…ja ulos. (lempeä kilahdus)", "pauseMs": 750 },
    { "mode": "firm_calm", "text": "Sano: \"Lopeta, kiitos. En pidä tuosta.\"", "pauseMs": 650 },
    { "mode": "listening", "text": "Kerro aikuiselle. Kenelle kerrot?", "pauseMs": 800 },
    { "mode": "warm", "text": "Valitse ystävällinen sana tilalle. Mikä sana on pehmeä? (pieni sparkle)", "pauseMs": 700 },
    { "mode": "listening", "text": "Mieti: Mikä sana tekee sinut iloiseksi? Mikä sana satuttaa?", "pauseMs": 950, "teacherPrompt": "Kysy esimerkkejä iloisista sanoista luokasta." },
    { "mode": "regulation", "text": "Hengitetään vielä kerran rauhassa.", "pauseMs": 700 },
    { "mode": "regulation", "text": "Sisään… (hiljainen hengitys)", "pauseMs": 650 },
    { "mode": "regulation", "text": "…ulos. (calm chime)", "pauseMs": 700 },
    { "mode": "warm", "text": "Hyvä. Ystävälliset sanat tuntuvat hyvältä.", "pauseMs": 650 },
    { "mode": "baseline", "text": "Hyvä. Ystävälliset sanat tekevät olon kevyt ja rauhallinen. Hengitetään hetki. (calm chime)", "pauseMs": 800 }
  ]
}
