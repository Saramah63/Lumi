{
  "id": "not_stopping",
  "title": "Ei kuunnella",
  "durationTarget": "3-4min",
  "steps": [
    { "mode": "baseline", "text": "Hei, olen Lumi.", "pauseMs": 350 },
    { "mode": "baseline", "text": "Puhutaan rajoista ja kuuntelemisesta.", "pauseMs": 400 },
    { "mode": "listening", "text": "Joku sanoo: \"Lopeta\". Toinen ei lopeta. Se tuntuu pahalta.", "pauseMs": 500 },
    { "mode": "listening", "text": "Miltä se tuntuu sinusta?", "pauseMs": 550, "teacherHint": "Tunnekuvat" },
    { "mode": "regulation", "text": "Hengitä sisään… ulos… Hidastetaan.", "pauseMs": 800 },
    { "mode": "firm_calm", "text": "Kolme askelta: sano \"Lopeta\", siirry pois, kerro aikuiselle.", "pauseMs": 600 },
    { "mode": "listening", "text": "Kenelle sinä kerrot, jos ei lopu?", "pauseMs": 500 },
    { "mode": "warm", "text": "Kysy ennen kosketusta: \"Saanko?\" Jos vastaus on ei, sano: \"Okei\".", "pauseMs": 550 },
    { "mode": "baseline", "text": "Hyvä. Kun kuuntelemme, kaikilla on turvallinen olo.", "pauseMs": 450 }
  ]
}
