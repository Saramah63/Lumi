{
  "id": "ruining_game",
  "title": "Tornin kaataminen",
  "learningGoal": "Harjoittelee pettymyksen tunnistamista ja ystävällistä korjaamista.",
  "durationTarget": "3-4min",
  "steps": [
    { "mode": "baseline", "text": "Hei, olen Lumi!", "pauseMs": 450 },
    { "mode": "baseline", "text": "Rakennetaan yhdessä. Täällä on turvallista.", "pauseMs": 500 },
    { "mode": "listening", "text": "Kuuluu kolahdus (palikat kaatuvat) juuri kun torni kaatuu.", "pauseMs": 550 },
    { "mode": "listening", "text": "Miltä se tuntuu, kun torni kaatuu?", "pauseMs": 950, "teacherHint": "Tunnekuvat" },
    { "mode": "regulation", "text": "Hengitä sisään…", "pauseMs": 650 },
    { "mode": "regulation", "text": "(hiljainen sisäänhengitys)", "pauseMs": 400 },
    { "mode": "regulation", "text": "…ja ulos. Laske yksi, kaksi, kolme.", "pauseMs": 750 },
    { "mode": "firm_calm", "text": "Sano: \"Lopeta, kiitos. Haluan rakentaa rauhassa.\"", "pauseMs": 650 },
    { "mode": "listening", "text": "Tarvitsetko apua? Pyydetään aikuinen mukaan.", "pauseMs": 750 },
    { "mode": "warm", "text": "Hyvä rauha. Se oli ystävällistä.", "pauseMs": 600 },
    { "mode": "listening", "text": "Mieti: Miltä sinusta tuntuu kun torni kaatuu? Mitä auttaa? (surullinen, vihainen, hämmentynyt)", "pauseMs": 950, "teacherPrompt": "Kysy lapsilta: miten voimme auttaa kun joku on harmissaan?" },
    { "mode": "regulation", "text": "Otetaan yksi rauhallinen hengitys.", "pauseMs": 700 },
    { "mode": "regulation", "text": "Hengitä sisään… (hiljainen hengitys)", "pauseMs": 650 },
    { "mode": "regulation", "text": "…ja puhalla ulos. (calm chime)", "pauseMs": 700 },
    { "mode": "warm", "text": "Hyvä. Rauha auttaa korjaamaan.", "pauseMs": 650 },
    { "mode": "warm", "text": "Korjataan. Sanotaan \"Anteeksi\" ja nostetaan palikat yhdessä. (pieni block fall -ääni kun nostetaan)", "pauseMs": 650 },
    { "mode": "baseline", "text": "Hyvä. Nyt torni nousee taas. Hengitä rauhassa. Leikitään ystävällisesti. (calm chime)", "pauseMs": 800 }
  ]
}
